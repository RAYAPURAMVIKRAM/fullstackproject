# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase Credentials (Get these from your Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Optional: Service Role Key (Bypasses Row Level Security for backend administrative tasks)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT Authentication Secret
JWT_SECRET=dental_clinic_super_secret_jwt_key_2026_replace_in_prod
JWT_EXPIRES_IN=24h

# Default Admin Seed Configuration (for `npm run seed`)
ADMIN_DEFAULT_EMAIL=admin@dentalclinic.com
ADMIN_DEFAULT_PASSWORD=admin123
ADMIN_DEFAULT_NAME=Dr. Sarah Mitchell
